{
  "name": "@nymrel/crawler-mesh",
  "version": "1.0.0",
  "description": "Bounded, zero-telemetry HTTP crawler and Markdown/JSON extractor for agent workflows",
  "keywords": [
    "crawler",
    "web-scraper",
    "markdown-extractor",
    "llm",
    "ai-agent",
    "rag",
    "robots-txt",
    "sitemap",
    "clean-markdown",
    "zero-telemetry",
    "nymrel"
  ],
  "homepage": "https://github.com/nymrel/nymrel-crawler-mesh#readme",
  "bugs": {
    "url": "https://github.com/nymrel/nymrel-crawler-mesh/issues"
  },
  "license": "MIT",
  "author": "Nymrel <contact@nymrel.com>",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "crawler-mesh": "bin/crawler-mesh.js",
    "radar-heal": "dist/src/radar-heal/cli.js"
  },
  "files": [
    "dist/src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true});\"",
    "prepack": "npm run check",
    "radar-heal": "node dist/src/radar-heal/cli.js"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "undici": "8.10.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.19.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymrel/nymrel-crawler-mesh.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
